{
  "name": "@halo-format/halo",
  "version": "0.3.1",
  "description": "Halo core: encode a value into a content-addressed navigable tree and read it back, verified. Zero runtime deps beyond a hashing primitive and a JCS canonicalizer.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "halo",
    "content-addressed",
    "merkle",
    "ai-agents",
    "tool-results",
    "llm"
  ],
  "homepage": "https://github.com/halo-format/halo#readme",
  "bugs": "https://github.com/halo-format/halo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halo-format/halo.git",
    "directory": "ts/packages/halo"
  },
  "dependencies": {
    "canonicalize": "^3.0.0"
  }
}
