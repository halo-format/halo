{
  "name": "@halo-format/claude",
  "version": "0.1.1",
  "description": "Halo adapter for Claude on two runtimes: the Agent SDK (installHalo — a PostToolUse encode hook + a single in-process halo_fetch MCP tool) and the raw Messages API (@halo-format/claude/raw — createRawHalo, no Agent SDK needed). Tool results become a shape map kept out of context.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@halo-format/halo": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.161",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "vitest": "^1.5.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "halo",
    "claude",
    "claude-agent-sdk",
    "messages-api",
    "mcp",
    "ai-agents",
    "tool-results"
  ],
  "homepage": "https://github.com/halo-format/halo/tree/main/ts/packages/claude#readme",
  "bugs": "https://github.com/halo-format/halo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halo-format/halo.git",
    "directory": "ts/packages/claude"
  }
}
