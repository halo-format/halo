{
  "name": "@halo-format/claude",
  "version": "0.0.0",
  "description": "Halo host adapter for the Claude Agent SDK: a PostToolUse encode hook (results become a shape map, out of context) plus a single in-process halo_fetch MCP tool. installHalo() wires it in one call.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@halo-format/halo": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.161",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "vitest": "^1.5.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "halo",
    "claude",
    "claude-agent-sdk",
    "mcp",
    "ai-agents",
    "tool-results"
  ],
  "homepage": "https://github.com/halo-format/halo/tree/main/ts/packages/claude#readme",
  "bugs": "https://github.com/halo-format/halo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halo-format/halo.git",
    "directory": "ts/packages/claude"
  }
}
