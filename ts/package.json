{
  "name": "@halo-format/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Halo TypeScript workspace (reference implementation)",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-python-version.mjs && pnpm install --lockfile-only",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
