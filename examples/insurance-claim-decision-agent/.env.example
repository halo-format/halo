# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# Permission mode the SDK runtime (agent/main.py) launches with. Defaults to
# bypassPermissions for an unattended demo; set to "default" in environments where
# bypass is disallowed (e.g. running as root) — the project's .claude/settings.json
# allow-lists every tool, so they are still auto-approved.
# AGENT_PERMISSION_MODE=default

# ── Environment DB (mimic_payer) — the agent reads/writes via the MCP server ──
# The MCP server connects with the LEAST-PRIVILEGE payer_agent role: it can read
# ext.* (the payer mirror) and read/write agent.* (its own state), and post the
# 835/EOB to ext.claim_lines only after a human resolves the review gate.
MIMIC_DB_DSN=postgresql://payer_agent:agent_demo_pw@localhost:5433/mimic_payer

# Admin DSN — used ONLY for seeding/initialisation, never handed to the agent.
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=5433
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=postgres

# How long payer_request_review blocks waiting for a human examiner, in seconds.
APPROVAL_TIMEOUT_SECONDS=900
APPROVAL_POLL_SECONDS=2

# Claims charged at or below this (cents), with every line a clean "pay", can
# auto-finalize; anything above goes to a human even if all lines pay.
AUTO_FINALIZE_MAX_CENTS=50000
