# ── Anthropic (via langchain-anthropic ChatAnthropic) ────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# ── Environment DB (mimic_payer) — the tools read/write via the least-priv role
MIMIC_DB_DSN=postgresql://payer_agent:agent_demo_pw@localhost:5433/mimic_payer

# Admin DSN parts — used ONLY for init/seed, never handed to the agent.
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=5433
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=postgres

# How long payer_request_review blocks waiting for a human examiner, in seconds.
APPROVAL_TIMEOUT_SECONDS=900
APPROVAL_POLL_SECONDS=2

# Claims charged at or below this (cents), all lines clean "pay", can auto-finalize.
AUTO_FINALIZE_MAX_CENTS=50000
